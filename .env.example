# Lead Ingestion Integrations (Optional)

# 1. Slack Notifications: paste your Slack Incoming Webhook URL to get instant lead alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_SLACK_WEBHOOK_URL

# 2. CRM / Zapier / Make Webhook: forward leads directly to HubSpot, Salesforce, or Airtable
CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_WEBHOOK_URL

# 3. Port for local preview server (default: 3000)
PORT=3000

